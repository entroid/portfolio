# Copy this file to .env.local and fill in real values for local development.
# No backend/server env vars are needed — everything here is build-time/public
# configuration for the static site (see docs/ARCHITECTURE.md).

# Production site origin, used for metadata/sitemap/OG tags (Phase 10).
NEXT_PUBLIC_SITE_URL=https://example.com

# FormSubmit target address for the contact form (Phase 7).
# Requires a one-time confirmation click on the first real submission —
# see docs/IMPLEMENTATION_PLAN.md Phase 7.
NEXT_PUBLIC_FORMSUBMIT_EMAIL=example@example.com
